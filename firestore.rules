rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Children collection - users can only access their own children
    // Note: field is userRef (camelCase) in Firestore, not user_ref
    match /childern/{childId} {
      allow read, write: if isAuthenticated() &&
        (resource == null || resource.data.userRef == /databases/$(database)/documents/users/$(request.auth.uid));
      allow create: if isAuthenticated();
    }

    // Learning paths - users can only access their own
    match /learning_path/{pathId} {
      allow read, write: if isAuthenticated() &&
        (resource == null || resource.data.user_ref == /databases/$(database)/documents/users/$(request.auth.uid));
      allow create: if isAuthenticated();
    }

    // Learning path tasks - users can only access their own
    match /learning_path_tasks/{taskId} {
      allow read, write: if isAuthenticated() &&
        (resource == null || resource.data.user_ref == /databases/$(database)/documents/users/$(request.auth.uid));
      allow create: if isAuthenticated();
    }

    // Skill paths - users can only access their own
    match /skill_paths/{pathId} {
      allow read, write: if isAuthenticated() &&
        (resource == null || resource.data.user_ref == /databases/$(database)/documents/users/$(request.auth.uid));
      allow create: if isAuthenticated();
    }

    // Accomplished milestones - users can read/write if authenticated
    // TYPO WARNING: "accomlished" should be "accomplished" - verify your collection name!
    match /children_accomlished_milestones/{id} {
      allow read, write: if isAuthenticated();
    }

    // Static milestones - read only for authenticated users (TYPO: should be "static")
    // This rule likely doesn't match any collection - see Static_Milestones below for correct rule
    match /satic_milestones/{id} {
      allow read: if isAuthenticated();
      allow write: if false; // Admin only via Firebase Console
    }

    // Static Milestones (correct collection name) - read only for authenticated users
    match /Static_Milestones/{id} {
      allow read: if isAuthenticated();
      allow write: if false; // Admin only via Firebase Console
    }

    // Meals - users can read any meal (their own or curated), write only their own
    match /meal/{mealId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() &&
        (resource == null || resource.data.user_ref == /databases/$(database)/documents/users/$(request.auth.uid));
      allow create: if isAuthenticated();
    }

    // Meal plans - users can only access their own
    match /meal_plan/{planId} {
      allow read, write: if isAuthenticated() &&
        (resource == null || resource.data.user_ref == /databases/$(database)/documents/users/$(request.auth.uid));
      allow create: if isAuthenticated();
    }

    // Meal combos - read for all authenticated users (shared recipes)
    match /meal_combo/{comboId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() &&
        (resource == null || resource.data.user_ref == /databases/$(database)/documents/users/$(request.auth.uid));
      allow create: if isAuthenticated();
    }

    // Events and tasks - users can only access their own
    match /event_and_task/{eventId} {
      allow read, write: if isAuthenticated() &&
        (resource == null || resource.data.user_ref == /databases/$(database)/documents/users/$(request.auth.uid));
      allow create: if isAuthenticated();
    }

    // Todos - users can only access their own
    match /todos/{todoId} {
      allow read, write: if isAuthenticated() &&
        (resource == null || resource.data.user_ref == /databases/$(database)/documents/users/$(request.auth.uid));
      allow create: if isAuthenticated();
    }

    // Planned activities - users can only access their own
    match /planned_activities/{activityId} {
      allow read, write: if isAuthenticated() &&
        (resource == null || resource.data.user_ref == /databases/$(database)/documents/users/$(request.auth.uid));
      allow create: if isAuthenticated();
    }

    // Activities - read-only for authenticated users
    match /activity/{activityId} {
      allow read: if isAuthenticated();
      allow write: if false;
      allow delete: if false;
    }

    // User Activities - users can only access their own custom activities
    match /user_activities/{activityId} {
      allow read, write: if isAuthenticated() &&
        (resource == null || resource.data.user_ref == /databases/$(database)/documents/users/$(request.auth.uid));
      allow create: if isAuthenticated();
    }

    // Favourite meals - users can only access their own
    // TYPO WARNING: "favourit" should be "favourite" - verify your collection name!
    match /favourit_meal/{favId} {
      allow read, write: if isAuthenticated() &&
        (resource == null || resource.data.user_ref == /databases/$(database)/documents/users/$(request.auth.uid));
      allow create: if isAuthenticated();
    }

    // Users collection
    match /users/{userId} {
      allow read, write: if isOwner(userId);
      allow create: if isAuthenticated() && request.auth.uid == userId;
    }

    // Shared content - publicly readable by share_code, writable by owner
    match /shared_content/{contentId} {
      // Anyone authenticated can read shared content (for import)
      allow read: if isAuthenticated();
      // Only the owner can write/update their shared content
      allow write: if isAuthenticated() &&
        (resource == null || resource.data.shared_by_user == /databases/$(database)/documents/users/$(request.auth.uid));
      // Authenticated users can create shared content
      allow create: if isAuthenticated();
      // Allow incrementing view/import counts by anyone
      allow update: if isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['view_count', 'import_count']);
    }

    // Waitlist collection - public write (landing page), admin read
    match /waitlist/{waitlistId} {
      // Anyone can create waitlist entries (from website landing page)
      allow create: if true;
      // No public read access (admin only via Firebase Console)
      allow read: if false;
      // No public updates (Cloud Function updates email_sent status)
      allow update: if false;
      allow delete: if false;
    }

    // Default deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
