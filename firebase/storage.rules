rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth.uid == userId;
    }
    match /helpful_docs/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Creator-uploaded custom fonts. Publicly readable so the follower
    // runtime can download them; writable only by authed users (we
    // further scope by creatorId subfolder via app logic).
    match /creator_fonts/{creatorId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}